{
    "appName": "HYOAI",
    "defaultModel": "ollama",
    "models": [
        {
            "id": "ollama",
            "name": "Ollama (local)",
            "baseUrl": "http://127.0.0.1:11434/v1",
            "type": "openai",
            "model": "llama3.2:1b",
            "streaming": true,
            "sendContext": true
        },
        {
            "id": "openrouter",
            "name": "OpenRouter (public API)",
            "baseUrl": "https://openrouter.ai/api/v1",
            "type": "openai",
            "model": "openai/gpt-4o-mini",
            "apiKey": "sk-or-xxxxxxxx",
            "streaming": true,
            "sendContext": true,
            "modalities": { "image": true }
        },
        {
            "id": "claude",
            "name": "Claude (Anthropic)",
            "baseUrl": "https://api.anthropic.com/v1",
            "type": "openai",
            "model": "claude-sonnet-4-6",
            "apiKey": "sk-ant-xxxxxxxx",
            "streaming": true,
            "headers": { "anthropic-dangerous-direct-browser-access": "true" },
            "modalities": { "image": true }
        },
        {
            "id": "llamacpp",
            "name": "Local llama.cpp",
            "baseUrl": "http://127.0.0.1:8080",
            "type": "llama.cpp",
            "streaming": true,
            "effort": {
                "default": "medium",
                "levels": [
                    { "id": "low", "label": "Low", "body": { "reasoning_effort": "low" } },
                    { "id": "medium", "label": "Medium", "body": { "reasoning_effort": "medium" } },
                    { "id": "high", "label": "High", "body": { "reasoning_effort": "high" } }
                ]
            }
        },
        {
            "id": "vllm",
            "name": "vLLM server",
            "baseUrl": "http://127.0.0.1:8000/v1",
            "type": "vllm",
            "model": "Qwen/Qwen2.5-7B-Instruct",
            "tools": true,
            "parallelToolCalls": true,
            "recoverToolCalls": true,
            "mcpServers": ["docs"],
            "disabled": true
        },
        {
            "id": "proxy",
            "name": "Same-origin reverse proxy (no CORS)",
            "baseUrl": "/llm",
            "type": "llama.cpp",
            "sendContext": true
        }
    ],
    "thinking": {
        "on": { "chat_template_kwargs": { "enable_thinking": true } },
        "off": { "chat_template_kwargs": { "enable_thinking": false } }
    },
    "mcp": {
        "servers": [
            {
                "id": "docs",
                "label": "Product docs",
                "url": "/mcp/docs",
                "transport": "auto",
                "headers": { "Authorization": "Bearer xxxxxxxx" },
                "enabled": false
            }
        ]
    },
    "placeholders": {
        "en": ["Translate a text...", "Explain a concept...", "Write a function..."],
        "fr": ["Traduis un texte...", "Explique un concept...", "Écris une fonction..."]
    },
    "suggestions": {
        "en": [
            {
                "label": "Write",
                "icon": "pen-line",
                "items": [
                    {
                        "title": "Draft a follow-up email",
                        "prompt": "Write a short, polite follow-up email for a customer who has not answered in a week. If you need more information, ask me one or two key questions right away."
                    },
                    { "title": "Summarize a document" }
                ]
            },
            {
                "label": "Code",
                "icon": "code",
                "items": [
                    {
                        "title": "Explain an error message",
                        "prompt": "Explain the error message I am about to paste and suggest a fix. Ask me for the code involved if needed."
                    }
                ]
            }
        ],
        "fr": [
            {
                "label": "Écrire",
                "icon": "pen-line",
                "items": [
                    {
                        "title": "Rédiger un e-mail de relance",
                        "prompt": "Rédige un e-mail de relance poli et court pour un client qui n'a pas répondu depuis une semaine. Si tu as besoin de précisions, pose-moi une ou deux questions clés tout de suite."
                    },
                    { "title": "Résumer un document" }
                ]
            },
            {
                "label": "Coder",
                "icon": "code",
                "items": [
                    {
                        "title": "Expliquer un message d'erreur",
                        "prompt": "Explique-moi le message d'erreur que je vais te coller et propose une correction. Demande-moi le code concerné si besoin."
                    }
                ]
            }
        ]
    },
    "integrations": [
        {
            "id": "feedback",
            "kind": "feedback",
            "url": "https://collector.example.com/feedback",
            "headers": { "Authorization": "Bearer xxxxxxxx" },
            "models": ["ollama"]
        }
    ]
}
